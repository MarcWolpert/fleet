#!/bin/sh
# Fleet Live launcher for macOS and Linux: starts the read-only collector and opens the app window.
# Usage: ./fleet-live [--port 4518] [--config ~/.config/fleet/machines.toml]
DIR=$(cd "$(dirname "$0")" && pwd)
PY=$(command -v python3) || { echo "Fleet Live needs Python 3.11 or newer" >&2; exit 1; }
"$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' || { echo "Fleet Live needs Python 3.11 or newer (found $("$PY" -V))" >&2; exit 1; }
exec "$PY" "$DIR/fleet_live.py" --open "$@"
